{
  "cleanUrls": true,
  "headers": [
    { "source": "/(car.glb|sky.hdr)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" } ] },
    { "source": "/app.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" } ] }
  ]
}
